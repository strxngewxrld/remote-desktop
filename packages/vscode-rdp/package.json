{
  "name": "vscode-rdp",
  "displayName": "Remote Desktop (RDP)",
  "description": "Vollwertige RDP-Sitzungen direkt in VS Code - mit eigener TypeScript-Implementierung des Protokolls, inklusive NLA.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rdp",
    "remote desktop",
    "mstsc",
    "windows",
    "terminal server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rdp-explorer",
          "title": "Remote Desktop",
          "icon": "media/rdp-icon.svg"
        }
      ]
    },
    "views": {
      "rdp-explorer": [
        {
          "id": "rdpConnections",
          "name": "Verbindungen",
          "icon": "media/rdp-icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rdpConnections",
        "contents": "Noch keine Verbindung gespeichert.\n[Verbindung hinzufügen](command:rdp.addConnection)\n[.rdp-Datei importieren](command:rdp.importRdpFile)\n[Einmalig verbinden](command:rdp.connect)"
      }
    ],
    "commands": [
      {
        "command": "rdp.connect",
        "title": "RDP: Verbinden mit…",
        "icon": "$(plug)"
      },
      {
        "command": "rdp.addConnection",
        "title": "RDP: Verbindung hinzufügen",
        "icon": "$(add)"
      },
      {
        "command": "rdp.connectSaved",
        "title": "RDP: Gespeicherte Verbindung öffnen",
        "icon": "$(play)"
      },
      {
        "command": "rdp.editConnection",
        "title": "RDP: Verbindung bearbeiten",
        "icon": "$(edit)"
      },
      {
        "command": "rdp.deleteConnection",
        "title": "RDP: Verbindung löschen",
        "icon": "$(trash)"
      },
      {
        "command": "rdp.refreshConnections",
        "title": "RDP: Liste aktualisieren",
        "icon": "$(refresh)"
      },
      {
        "command": "rdp.addFolder",
        "title": "RDP: Ordner hinzufügen",
        "icon": "$(new-folder)"
      },
      {
        "command": "rdp.renameFolder",
        "title": "RDP: Ordner umbenennen",
        "icon": "$(edit)"
      },
      {
        "command": "rdp.deleteFolder",
        "title": "RDP: Ordner löschen",
        "icon": "$(trash)"
      },
      {
        "command": "rdp.editFolderSettings",
        "title": "RDP: Vererbte Einstellungen des Ordners…",
        "icon": "$(settings-gear)"
      },
      {
        "command": "rdp.moveToFolder",
        "title": "RDP: In Ordner verschieben",
        "icon": "$(move)"
      },
      {
        "command": "rdp.editTags",
        "title": "RDP: Tags bearbeiten",
        "icon": "$(tag)"
      },
      {
        "command": "rdp.searchConnections",
        "title": "RDP: Verbindung suchen (Name, Host, Tag)",
        "icon": "$(search)"
      },
      {
        "command": "rdp.filterConnections",
        "title": "RDP: Baumansicht filtern",
        "icon": "$(filter)"
      },
      {
        "command": "rdp.clearConnectionFilter",
        "title": "RDP: Filter der Baumansicht aufheben",
        "icon": "$(clear-all)"
      },
      {
        "command": "rdp.setBandwidthProfile",
        "title": "RDP: Bandbreitenprofil setzen",
        "icon": "$(dashboard)"
      },
      {
        "command": "rdp.importRdpFile",
        "title": "RDP: .rdp-Datei importieren",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rdp.exportRdpFile",
        "title": "RDP: Als .rdp-Datei exportieren",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "rdp.disconnect",
        "title": "RDP: Sitzung trennen"
      },
      {
        "command": "rdp.sendCtrlAltDel",
        "title": "RDP: Strg+Alt+Entf senden"
      },
      {
        "command": "rdp.toggleScaling",
        "title": "RDP: Skalierung umschalten"
      },
      {
        "command": "rdp.toggleDiagnostics",
        "title": "RDP: Diagnose-Overlay ein-/ausblenden"
      },
      {
        "command": "rdp.refreshScreen",
        "title": "RDP: Bildschirm neu anfordern"
      },
      {
        "command": "rdp.clearCredentials",
        "title": "RDP: Gespeichertes Passwort löschen"
      },
      {
        "command": "rdp.showLog",
        "title": "RDP: Protokoll anzeigen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rdp.addConnection",
          "when": "view == rdpConnections",
          "group": "navigation@1"
        },
        {
          "command": "rdp.refreshConnections",
          "when": "view == rdpConnections",
          "group": "navigation@2"
        },
        {
          "command": "rdp.addFolder",
          "when": "view == rdpConnections",
          "group": "navigation@3"
        },
        {
          "command": "rdp.filterConnections",
          "when": "view == rdpConnections",
          "group": "navigation@4"
        },
        {
          "command": "rdp.clearConnectionFilter",
          "when": "view == rdpConnections && rdp.filterAktiv",
          "group": "navigation@5"
        },
        {
          "command": "rdp.importRdpFile",
          "when": "view == rdpConnections",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "rdp.connectSaved",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "inline@1"
        },
        {
          "command": "rdp.editConnection",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "1_modify@1"
        },
        {
          "command": "rdp.clearCredentials",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "1_modify@2"
        },
        {
          "command": "rdp.editTags",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "1_modify@3"
        },
        {
          "command": "rdp.setBandwidthProfile",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "1_modify@4"
        },
        {
          "command": "rdp.moveToFolder",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "1_modify@5"
        },
        {
          "command": "rdp.exportRdpFile",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "2_transfer@1"
        },
        {
          "command": "rdp.addConnection",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "1_modify@1"
        },
        {
          "command": "rdp.addFolder",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "1_modify@2"
        },
        {
          "command": "rdp.renameFolder",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "1_modify@3"
        },
        {
          "command": "rdp.editFolderSettings",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "1_modify@4"
        },
        {
          "command": "rdp.setBandwidthProfile",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "1_modify@5"
        },
        {
          "command": "rdp.moveToFolder",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "1_modify@6"
        },
        {
          "command": "rdp.importRdpFile",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "2_transfer@1"
        },
        {
          "command": "rdp.deleteConnection",
          "when": "view == rdpConnections && viewItem == rdpConnection",
          "group": "9_danger@1"
        },
        {
          "command": "rdp.deleteFolder",
          "when": "view == rdpConnections && viewItem == rdpFolder",
          "group": "9_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "rdp.connectSaved",
          "when": "false"
        },
        {
          "command": "rdp.editConnection",
          "when": "false"
        },
        {
          "command": "rdp.deleteConnection",
          "when": "false"
        },
        {
          "command": "rdp.refreshConnections",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rdp.sendCtrlAltDel",
        "key": "ctrl+alt+end",
        "mac": "ctrl+alt+end",
        "when": "rdp.sessionFocused"
      }
    ],
    "configuration": {
      "title": "Remote Desktop (RDP)",
      "properties": {
        "rdp.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Gespeicherte Verbindungen und Ordner. Passwörter werden **nicht** hier abgelegt, sondern im sicheren Speicher von VS Code.\n\nEin Eintrag ist entweder eine Verbindung (`host`) oder ein Ordner (`type: \"folder\"` mit `children`). Ordner dürfen verschachtelt werden und vererben ihre `settings` an alles, was in ihnen liegt. Die Auflösungsreihenfolge lautet: Verbindung schlägt Ordner, Ordner schlägt Elternordner, Elternordner schlägt globale Einstellung. Das alte flache Format ohne Ordner bleibt unverändert gültig.",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "title": "Verbindung",
                "required": [
                  "name",
                  "host"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Anzeigename"
                  },
                  "host": {
                    "type": "string",
                    "description": "Hostname oder IP-Adresse"
                  },
                  "port": {
                    "type": "number",
                    "default": 3389
                  },
                  "username": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number",
                    "description": "Leer lassen für automatische Größe"
                  },
                  "height": {
                    "type": "number"
                  },
                  "colorDepth": {
                    "type": "number",
                    "enum": [
                      15,
                      16,
                      24,
                      32
                    ],
                    "default": 32
                  },
                  "keyboardLayout": {
                    "type": "string",
                    "description": "z.B. de-DE, en-US oder eine Layout-ID wie 0x407"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Schlagworte für Suche und Filter"
                  },
                  "bandwidthProfile": {
                    "type": "string",
                    "enum": [
                      "lan",
                      "broadband",
                      "mobile"
                    ],
                    "enumDescriptions": [
                      "Alle Effekte an",
                      "Hintergrundbild, Fensterinhalt beim Ziehen und Menüanimationen aus",
                      "Alle Effekte aus"
                    ],
                    "description": "Bandbreitenprofil dieser Verbindung"
                  }
                }
              },
              {
                "type": "object",
                "title": "Ordner",
                "required": [
                  "name",
                  "children"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "folder"
                    ],
                    "description": "Kennzeichnet den Eintrag als Ordner"
                  },
                  "name": {
                    "type": "string",
                    "description": "Anzeigename des Ordners"
                  },
                  "children": {
                    "type": "array",
                    "description": "Verbindungen und weitere Ordner"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Gelten zusätzlich für alle enthaltenen Verbindungen"
                  },
                  "settings": {
                    "type": "object",
                    "description": "Wird an alle enthaltenen Verbindungen vererbt; einzelne Verbindungen dürfen überschreiben.",
                    "properties": {
                      "port": {
                        "type": "number"
                      },
                      "username": {
                        "type": "string"
                      },
                      "domain": {
                        "type": "string"
                      },
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      },
                      "colorDepth": {
                        "type": "number",
                        "enum": [
                          15,
                          16,
                          24,
                          32
                        ]
                      },
                      "keyboardLayout": {
                        "type": "string"
                      },
                      "bandwidthProfile": {
                        "type": "string",
                        "enum": [
                          "lan",
                          "broadband",
                          "mobile"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "rdp.defaultKeyboardLayout": {
          "type": "string",
          "default": "de-DE",
          "enum": [
            "de-DE",
            "de-CH",
            "en-US",
            "en-GB",
            "fr-FR",
            "es-ES",
            "it-IT",
            "pt-BR",
            "nl-NL",
            "sv-SE",
            "pl-PL",
            "ru-RU",
            "ja-JP"
          ],
          "description": "Tastaturlayout, das dem Server gemeldet wird."
        },
        "rdp.defaultColorDepth": {
          "type": "number",
          "default": 32,
          "enum": [
            15,
            16,
            24,
            32
          ],
          "markdownDescription": "Angeforderte Farbtiefe. **32** ist der Standard; der planare Codec wird unterstützt. Niedrigere Werte sind nur für Server sinnvoll, die 32 Bit ablehnen. Der Server darf die Farbtiefe ohnehin vorgeben – seine Angabe gewinnt."
        },
        "rdp.scaling": {
          "type": "string",
          "default": "fit",
          "enum": [
            "fit",
            "none"
          ],
          "enumDescriptions": [
            "Bild an die Panelgröße anpassen",
            "Originalgröße mit Bildlaufleisten"
          ],
          "description": "Darstellung der Remote-Oberfläche."
        },
        "rdp.smoothScaling": {
          "type": "boolean",
          "default": false,
          "description": "Bild beim Skalieren glätten. Aus wirkt bei Text meist schärfer."
        },
        "rdp.diagnostics.showOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Diagnose-Overlay beim Start einer Sitzung einblenden. Der zuletzt über „RDP: Diagnose-Overlay ein-/ausblenden“ gewählte Zustand hat Vorrang."
        },
        "rdp.certificateTrust": {
          "type": "string",
          "default": "trust-on-first-use",
          "enum": [
            "trust-on-first-use",
            "always-ask",
            "ignore"
          ],
          "enumDescriptions": [
            "Beim ersten Verbinden nachfragen und den Fingerabdruck merken",
            "Bei jeder Verbindung nachfragen",
            "Zertifikate ohne Prüfung akzeptieren (nicht empfohlen)"
          ],
          "description": "Umgang mit den meist selbstsignierten Zertifikaten von RDP-Servern."
        },
        "rdp.defaultBandwidthProfile": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "lan",
            "broadband",
            "mobile"
          ],
          "enumDescriptions": [
            "Kein Profil – es gelten die einzelnen Schalter unter rdp.performance.*",
            "LAN: alle Effekte an, inklusive Desktopkomposition und Schriftglättung",
            "Breitband: Hintergrundbild, Fensterinhalt beim Ziehen und Menüanimationen aus",
            "Mobil (langsam): alle Effekte aus"
          ],
          "markdownDescription": "Bandbreitenprofil für Verbindungen ohne eigene Angabe. Ein Profil setzt die `TS_PERF_*`-Flags des Client Info PDU in einem Rutsch und gewinnt gegen die einzelnen `rdp.performance.*`-Schalter. Reihenfolge: Verbindung, Ordner, Elternordner, dann dieser Wert.",
          "scope": "window"
        },
        "rdp.performance.disableWallpaper": {
          "type": "boolean",
          "default": true,
          "description": "Desktophintergrund in der Sitzung abschalten."
        },
        "rdp.performance.disableThemes": {
          "type": "boolean",
          "default": false,
          "description": "Visuelle Stile abschalten."
        },
        "rdp.performance.disableMenuAnimations": {
          "type": "boolean",
          "default": true,
          "description": "Menüanimationen abschalten."
        },
        "rdp.performance.disableFullWindowDrag": {
          "type": "boolean",
          "default": true,
          "description": "Fensterinhalt beim Ziehen nicht anzeigen."
        },
        "rdp.performance.enableFontSmoothing": {
          "type": "boolean",
          "default": true,
          "description": "Schriftglättung (ClearType) aktivieren."
        },
        "rdp.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "description": "Detailgrad der Protokollausgabe im Ausgabekanal."
        },
        "rdp.connectTimeout": {
          "type": "number",
          "default": 15000,
          "description": "Zeitlimit für den Verbindungsaufbau in Millisekunden."
        },
        "rdp.highDpi": {
          "type": "boolean",
          "default": false,
          "description": "Auf hochauflösenden Bildschirmen die volle Pixeldichte anfordern. Schärferes Bild, aber deutlich mehr Datenvolumen und kleinere Schrift in der Sitzung. Gilt sowohl beim Verbinden als auch für jede spätere Größenänderung des Panels."
        },
        "rdp.dynamicResolution": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Die Desktopauflösung der Größe des Panels folgen lassen (**MS-RDPEDISP**). Ohne diese Funktion bleibt die beim Verbinden ausgehandelte Auflösung bestehen und das Bild wird beim Vergrößern nur unscharf skaliert. Server, die den Kanal nicht anbieten, verhalten sich unverändert."
        },
        "rdp.dynamicResolutionDelay": {
          "type": "number",
          "default": 400,
          "markdownDescription": "Ruhezeit in Millisekunden, bevor nach einer Größenänderung eine neue Auflösung angefragt wird. Jeder Wechsel verwirft serverseitig den Bildschirminhalt, deshalb wird beim Ziehen an der Fensterkante nicht bei jedem Pixel angefragt."
        },
        "rdp.graphicsPipeline": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Die **Graphics Pipeline** (MS-RDPEGFX) anfordern. Windows Server 2019+ liefert Bildschirminhalte ausschließlich auf diesem Weg; ohne die Pipeline bleibt das Bild dort schwarz. Ältere Server nutzen weiterhin den klassischen Weg."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=30000 dist-test/test/*.test.js",
    "test:vscode": "tsc -p tsconfig.integration.json && vscode-test"
  },
  "dependencies": {
    "ts-rdp": "*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.1",
    "typescript": "^5.6.3"
  }
}
