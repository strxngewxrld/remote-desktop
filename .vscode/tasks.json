{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "label": "npm: test"
    },
    {
      "label": "RDP: VSIX bauen",
      "detail": "Baut und prüft die Extension unter artifacts/*.vsix",
      "type": "shell",
      "command": "npm run package",
      "problemMatcher": []
    },
    {
      "label": "RDP: Veröffentlichen (GitHub Packages)",
      "detail": "Version anheben, bauen, testen, VSIX packen und als @<owner>/vscode-rdp hochladen",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/publish-github.mjs",
        "--owner",
        "${input:githubOwner}",
        "--bump",
        "${input:versionBump}"
      ],
      "options": {
        "env": {
          "NODE_AUTH_TOKEN": "${input:githubToken}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "RDP: Veröffentlichen – Probelauf",
      "detail": "Wie Veröffentlichen, aber ohne Versionssprung und ohne Upload",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/publish-github.mjs",
        "--owner",
        "${input:githubOwner}",
        "--bump",
        "none",
        "--dry-run"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "githubOwner",
      "type": "promptString",
      "description": "GitHub-Benutzer oder -Organisation, unter der das Paket liegt",
      "default": "strxngewxrld"
    },
    {
      "id": "versionBump",
      "type": "pickString",
      "description": "Versionssprung",
      "options": [
        "patch",
        "minor",
        "major",
        "none"
      ],
      "default": "patch"
    },
    {
      "id": "githubToken",
      "type": "promptString",
      "description": "Personal Access Token mit write:packages (wird nicht gespeichert)",
      "password": true
    }
  ]
}
