{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "label": "npm: test"
    },
    {
      "label": "RDP: VSIX bauen",
      "detail": "Baut und prüft die Extension unter artifacts/*.vsix",
      "type": "shell",
      "command": "npm run package",
      "problemMatcher": []
    },
    {
      "label": "RDP: Release erstellen",
      "detail": "Version anheben, Changelog umstellen, prüfen, taggen und pushen; GitHub Actions erstellt das Release",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/release.mjs",
        "--bump",
        "${input:versionBump}"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "RDP: Release – Probelauf",
      "detail": "Wie Release erstellen, aber ohne Änderungen, Commit oder Push",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/release.mjs",
        "--bump",
        "${input:versionBump}",
        "--dry-run"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "versionBump",
      "type": "pickString",
      "description": "Versionssprung",
      "options": [
        "patch",
        "minor",
        "major"
      ],
      "default": "patch"
    }
  ]
}
