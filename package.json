{
  "name": "remote-desktop-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "RDP in VS Code: eigene TypeScript-RDP-Library + VS Code Extension",
  "author": "Tom Knüppel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strxngewxrld/remote-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/strxngewxrld/remote-desktop/issues"
  },
  "homepage": "https://github.com/strxngewxrld/remote-desktop#readme",
  "workspaces": [
    "packages/ts-rdp",
    "packages/vscode-rdp"
  ],
  "scripts": {
    "build": "npm run build -w ts-rdp && npm run build -w vscode-rdp",
    "test": "npm run test -w ts-rdp && npm run test -w vscode-rdp",
    "package": "npm run package -w vscode-rdp",
    "test:vscode": "npm run test:vscode -w vscode-rdp",
    "typecheck": "npm run typecheck --workspaces",
    "check:docs": "node tools/check-docs.mjs",
    "check:package": "node tools/check-package.mjs",
    "publish:github": "node tools/publish-github.mjs",
    "test:tooling": "node --test tools/test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
